# .config Linux minimo per SPEACE OS
# Arch: x86_64
# Compilato in: kernel/build-kernel.sh

CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_LOCALVERSION="-speace-os"
CONFIG_SMP=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y

# Scheduler / processi
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y

# Filesystem
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_ISO9660_FS=y
CONFIG_SQUASHFS=y

# TTY / console
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# Bus support
CONFIG_PCI=y
CONFIG_PCI_MSI=y

# Executable file formats
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# SCSI subsystem (necessario per sd* e sr* device)
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y      # /dev/sda, /dev/sdb etc.
CONFIG_BLK_DEV_SR=y      # /dev/sr0 (CD-ROM)
CONFIG_SR_DEV_IOCTL=y
CONFIG_CHR_DEV_SG=y

# Driver base (no GPU, no wireless, no bluetooth, no sound)
CONFIG_ATA=y
CONFIG_ATA_GENERIC=y
CONFIG_ATA_PIIX=y
CONFIG_SATA_AHCI=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_R8169=y

# USB storage (per boot da chiavetta USB)
CONFIG_USB=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_XHCI_HCD=y    # USB 3.0
CONFIG_USB_EHCI_HCD=y    # USB 2.0
CONFIG_USB_OHCI_HCD=y    # USB 1.1 (fallback)
CONFIG_USB_STORAGE=y     # USB mass storage

# VirtIO (per QEMU/KVM)
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_NET=y

# TTY / console
CONFIG_UNIX98_PTYS=y
CONFIG_DEVPTS_MULTIPLE_INSTANCES=y

# Initramfs / boot
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_XZ=y

# Sicurezza minimale (no LSM per semplicità)
# CONFIG_SECURITY è lasciato default n
